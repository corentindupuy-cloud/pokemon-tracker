# ─── Supabase ───────────────────────────────────────────────
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=your_service_role_or_anon_key

# ─── Serveur ──────────────────────────────────────────────
PORT=8000

# ─── eBay Browse API (OAuth2 Client Credentials) ────────────
# EBAY_CLIENT_ID     = App ID (Client ID)
# EBAY_CLIENT_SECRET = Cert ID (Client Secret)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_FR
USD_TO_EUR=0.92

# ─── Sync marché (appel depuis pokemon-cotes) ───────────────
# Secret partagé Mac ↔ Railway (header X-Sync-Secret)
SYNC_API_SECRET=

# ─── Google Sheets (migrate.py uniquement) ──────────────────
GOOGLE_CREDENTIALS_PATH=/chemin/vers/credentials.json
SPREADSHEET_ID=votre_spreadsheet_id
SHEET_TAB=Pokédex
