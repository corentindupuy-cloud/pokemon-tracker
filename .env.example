SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=your_service_role_or_anon_key
PORT=8000

# eBay Finding API (https://developer.ebay.com)
EBAY_APP_ID=ton_app_id
EBAY_CERT_ID=ton_cert_id
EBAY_ENV=production
# (compat) Ancienne variable, optionnelle
EBAY_API_KEY=your_ebay_app_id
# Taux USD→EUR si ventes en dollars (optionnel)
USD_TO_EUR=0.92

# Migration Google Sheets (migrate.py uniquement)
GOOGLE_CREDENTIALS_PATH=/chemin/vers/credentials.json
SPREADSHEET_ID=votre_spreadsheet_id
SHEET_TAB=Pokédex
